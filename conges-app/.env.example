# Secret de signature des sessions — OBLIGATOIRE en production (32 caractères minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Stockage : "fichier" (défaut, data/registre.json) ou "blobs" (Netlify Blobs, obligatoire sur Netlify).
# CONGES_STOCKAGE=blobs

# Pour les scripts registre:publier / registre:recuperer depuis votre poste :
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=

# Dossier du registre (par défaut : ./data). À placer sur un disque sauvegardé.
# CONGES_DATA_DIR=/var/lib/conges

# Uniquement pour un test local de `npm start` sans HTTPS : le cookie de session
# n'est alors pas marqué "Secure". Ne JAMAIS activer sur le serveur réel.
# COOKIE_INSECURE=1
